rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos ficam visíveis para qualquer pessoa que abra o álbum.
    // Só o login autenticado pode enviar/substituir/apagar fotos.
    // Limite de 8MB por foto e apenas imagens são aceitas.
    match /fotos/{paisId}/{arquivo} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
