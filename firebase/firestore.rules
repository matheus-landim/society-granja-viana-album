rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Qualquer pessoa pode VER o álbum (não precisa de login para navegar
    // pelas 16 páginas). Só quem estiver autenticado (o login único do
    // responsável pelo álbum) pode ESCREVER (adicionar/editar/remover
    // figurinhas e trocar a capa).
    match /paginas/{paginaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
